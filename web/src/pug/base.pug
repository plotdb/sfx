//- module
doctype html
html(lang="zh-Hant")
  block var
  head
    meta(charset="utf-8")
    meta(name="viewport",content="width=device-width,initial-scale=1")
    block prehead
    +css([
    {name: "bootstrap", path: "css/bootstrap.min.css"},
    {name: "@loadingio/bootstrap.ext"}
    ])
    block head
  body
    block body
    +script([
    {name: "@loadingio/ldquery"},
    {name: "ldview"},
    {name: "@plotdb/sfx", version: "dev"}
    ])
    block script
