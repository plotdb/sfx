extends /base.pug
block head
  title @plotdb/sfx
  style(type="text/css"): include:stylus index.styl
block body
  .page
    header.hero
      .brand
        h1 @plotdb/sfx
        p.lead 給確定性動畫用的音訊 runtime：聲音綁在動畫時間上，加上在瀏覽器裡算出來的合成音效，免費、可重現。
      nav.links
        a(href="#all") 音效清單
        a(href="#staff") 五線譜
        a(href="#synth") 合成細節
        a(href="#timeline") 時間軸
        a(href="https://github.com/plotdb/sfx") GitHub

    section#all
      .sec-head
        h2 音效清單
        p 點名稱播放預設的聲音；點 🎲 以預設為中心隨機變化 ( 數值依常態分布微調，選項如 #[code style] 隨機挑 )。要調參數請到下方的#[a(href="#synth") 合成細節]。
        code.lastvar(ld="lastvar")
      .quick-group(ld-each="qgroup")
        .quick-name(ld="name")
        .quick-list
          span.qitem(ld-each="quick")
            span.qchip(ld="chip")
              span.qname(ld="qname")
              span.qdesc(ld="qdesc")
            span.qdice(ld="qdice",title="隨機變化") 🎲

    section#staff
      .sec-head
        h2 五線譜
        p 點選音符後用鍵盤編輯，拖曳上下改音高；也可以直接改下方的樂譜文字。以 #[code sfx.synth.score] 用選定的聲音演奏 ( 不是樂器的聲音會變調演奏 )。
      .staff-wrap
        .staff-box(tabindex="0")
          svg
        .staff-keys
          span #[kbd 1]~#[kbd 8] 全、二分、四分、八分、十六分、三十二分…音符
          span #[kbd .] 附點 ( 再按取消 )
          span #[kbd -] 休止 #[kbd +] 有聲音
          span #[kbd ←]#[kbd →] 選取 #[kbd ↑]#[kbd ↓] 音高
          span #[kbd space] 播放
        .staff-ctrl
          button.play(data-act="play") ▶ 播放
          label 樂器
          select.inst
          button.copy(data-act="dice",title="隨機換一種樂器") 🎲
          label 速度
          input.bpm(type="range",min="40",max="200",step="1",value="100")
          span.num.bpm-val 100
          span.sel-info
          span.msg
        .score-row
          label 樂譜
          input.score-text(type="text",spellcheck="false")
        .card-foot
          code.staff-code
          button.copy(data-act="copy") 複製

    section#synth
      .sec-head
        h2 全部音效：合成細節
        p 每種聲音都可以調參數。拖拉滑桿放開時會播放；點波形也會播。同樣的參數永遠是同樣的聲音；#[code vary] 加上變化 ( 音高、長度、音量與雜訊質感 )；按 🎲 以目前的設定為中心隨機變化所有參數。
      .group(ld-each="group")
        h3(ld="name")
        .cards
          .card(ld-each="sound")
            .card-head
              span.name(ld="name")
              span.desc(ld="desc")
              span.len(ld="len")
            canvas.wave(ld="wave",title="播放")
            .params
              .param(ld-each="param")
                label(ld="key")
                input(ld="input")
                select(ld="select")
                span.num(ld="val")
            .presets
              span.chip(ld="reset") 預設
              span(ld-each="preset"): span.chip(ld="chip")
            .card-foot
              button.play(ld="play") ▶ 播放
              code(ld="code")
              button.copy(ld="dice",title="換一個變化 ( vary 與 seed )") 🎲
              button.copy(ld="copy",title="複製程式碼") 複製

    section#timeline
      .sec-head
        h2 時間軸
        p 聲音綁在動畫時間 #[code t] 上：播放、暫停、拖曳、倍速都會同步。這裡用自己的時鐘經 #[code sfx.transport] 驅動；頁面上有 lotion.player 時會自動攔截，不用另外接。
      .tl
        .mixer-row
          span.mixer-hint bus 音量 ( #[code sfx.volume] )：這段的低音與旋律走 music，其他走 sfx；voice 給旁白用
          .mixer
            .bus(ld-each="bus")
              label(ld="name")
              input(type="range",min="0",max="1",step="0.01",ld="input")
              span.num(ld="val")
        .stage
          .hit(ld-each="hit")
            .dot(ld="dot")
            .label(ld="label")
        canvas.track(ld="track",title="點擊或拖曳以跳到該時間")
        .controls
          button.play(ld="toggle")
          span.time(ld="time")
          .rates
            span(ld-each="rate"): span.chip(ld="chip")
          .grow
          button.ghost(ld="render") 混成 wav
          a.dl(ld="download",download="sfx-timeline.wav") 下載
        audio.out(ld="out",controls)
        .editor
          .editor-head
            span 場景 ( JSON )：#[code sounds] 是 #[code {名稱: [合成聲, 參數]}]，#[code timeline] 是 #[code sfx.timeline] 的項目
            button.ghost(ld="apply") 套用
          textarea(ld="src",spellcheck="false")
          .err(ld="err")

    footer
      span 用法與完整參數見
      a(href="https://github.com/plotdb/sfx#readme") README
block script
  script(type="module"): include:lsc index.ls
  script(type="module"): include:lsc staff.ls
