#!/usr/bin/env bash
# 失敗時中止, 避免留下看似成功的半成品
set -euo pipefail
bin=./node_modules/.bin
rm -rf dist
mkdir -p dist
echo "build src/index.ls -> dist/index.js ..."
$bin/lsc -cp --no-header src/index.ls > dist/index.js
$bin/uglifyjs dist/index.js -m -c > dist/index.min.js
echo "deploy dist/ into local web ( demo 用 ) ..."
rm -rf web/static/assets/lib/@plotdb/sfx/dev
mkdir -p web/static/assets/lib/@plotdb/sfx/dev
cp -R dist/* web/static/assets/lib/@plotdb/sfx/dev/
echo "done."
